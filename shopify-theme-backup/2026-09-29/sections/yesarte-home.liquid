      <a class="ya-cat ya-cat-logo" href="/#ya-design"><img src="https://cdn.shopify.com/s/files/1/0563/4434/6790/files/yesarte-cat-design.png?v=1789946244" width="600" height="800" loading="lazy" alt="Design"><span>Design<small>nova área</small></span></a>
    </div>
  </section>

  <section class="ya-section ya-featured">
    <div class="ya-section-head"><div><p>SELEÇÃO REAL DO CATÁLOGO</p><h2>Artistas & obras em destaque</h2></div></div>
    <div class="ya-products">
      {% for product in collections['julio-pomar-serigrafias'].products limit: 2 %}
        <a class="ya-product" href="{{ product.url }}">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420,650,900', sizes: '(max-width: 760px) 100vw, (max-width: 1180px) 50vw, 25vw', alt: product.title }}{% endif %}
          <div><p>Júlio Pomar</p><h3>{{ product.title }}</h3><span>Ver obra →</span></div>
        </a>
      {% endfor %}
      {% if cargaleiro != blank %}
        <a class="ya-product" href="{{ cargaleiro.url }}">
          {% if cargaleiro.featured_image %}{{ cargaleiro.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420,650,900', sizes: '(max-width: 760px) 100vw, (max-width: 1180px) 50vw, 25vw', alt: cargaleiro.title }}{% endif %}
