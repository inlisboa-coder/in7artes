      <a class="ya-cat ya-cat-logo" href="/collections/escultura"><img src="https://cdn.shopify.com/s/files/1/0563/4434/6790/files/yesarte-cat-escultura.png?v=1789946214" width="600" height="800" loading="lazy" alt="Escultura"><span>Escultura</span></a>
      <a class="ya-cat ya-cat-logo" href="/collections/all"><img src="https://cdn.shopify.com/s/files/1/0563/4434/6790/files/yesarte-cat-contemporanea.png?v=1789946218" width="600" height="800" loading="lazy" alt="Arte contemporânea"><span>Arte Contemporânea</span></a>
      <a class="ya-cat ya-cat-logo" href="/collections/vhils"><img src="https://cdn.shopify.com/s/files/1/0563/4434/6790/files/yesarte-cat-urbana.png?v=1789946223" width="600" height="800" loading="lazy" alt="Arte urbana"><span>Arte Urbana</span></a>
      <a class="ya-cat ya-cat-logo" href="/collections/in-lisboa-art-products"><img src="https://cdn.shopify.com/s/files/1/0563/4434/6790/files/yesarte-cat-lisboa.png?v=1789946228" width="600" height="800" loading="lazy" alt="Arte de Lisboa"><span>Arte de Lisboa</span></a>
      <a class="ya-cat ya-cat-logo" href="/collections/all"><img src="https://cdn.shopify.com/s/files/1/0563/4434/6790/files/yesarte-cat-portugal.png?v=1789946233" width="600" height="800" loading="lazy" alt="Arte portuguesa"><span>Arte Portuguesa</span></a>
