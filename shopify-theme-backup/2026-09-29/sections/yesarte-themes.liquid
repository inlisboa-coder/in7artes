{% stylesheet %}.ya-themes{background:#080809;color:#f4f1ee;padding:64px clamp(20px,4vw,70px);font-family:Arial,sans-serif}.ya-themes a{color:inherit;text-decoration:none}.ya-themes__head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:26px}.ya-themes__head p{margin:0;color:#d88a55;font-size:12px;letter-spacing:.22em}.ya-themes__head h2{margin:8px 0 0;font-size:clamp(30px,4vw,48px);font-weight:300}.ya-themes__head>a{color:#d88a55;font-size:12px;text-transform:uppercase}.ya-themes__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ya-theme-card{position:relative;min-height:440px;overflow:hidden;border:1px solid #44281c}.ya-theme-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .45s}.ya-theme-card:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(4,4,5,.96),transparent 72%)}.ya-theme-card>span{position:absolute;z-index:1;left:26px;bottom:25px;display:grid;grid-template-columns:auto 1fr;gap:7px 14px}.ya-theme-card small{grid-row:1/3;color:#d88a55}.ya-theme-card strong{font-size:24px;font-weight:400}.ya-theme-card em{color:#c4b6ad;font-family:Georgia,serif}.ya-theme-card:hover img{transform:scale(1.035)}@media(max-width:760px){.ya-themes{padding:46px 16px}.ya-themes__head{align-items:flex-start;flex-direction:column}.ya-themes__grid{grid-template-columns:1fr}.ya-theme-card{min-height:360px}}{% endstylesheet %}
